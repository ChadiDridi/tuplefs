      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Two layouts: where file contents live" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1f2328;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="840" height="30" as="geometry"/></mxCell><mxCell id="c2" value="default layout: everything in the database" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;dashed=0;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=2;fontColor=#57606a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="405" height="400" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;FUSE&lt;/b&gt; &lt;font style='font-size:11px' color='#57606a'&gt;(kernel)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff4ce;strokeColor=#bf8700;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="112" y="85" width="180" height="48" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;tuplefs&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="112" y="195" width="180" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;database&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#57606a'&gt;inodes · dirents · xattrs&lt;/font&gt;&lt;br&gt;&lt;b&gt;blocks&lt;/b&gt; &lt;font style='font-size:11px' color='#57606a'&gt;= file contents&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dafbe1;strokeColor=#1a7f37;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="82" y="305" width="240" height="112" as="geometry"/></mxCell><mxCell id="c6" value="every request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="metadata and data:&lt;br&gt;one transaction each" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="hybrid layout: mkfs -data files" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;dashed=0;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=2;fontColor=#57606a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="435" y="40" width="405" height="400" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;FUSE&lt;/b&gt; &lt;font style='font-size:11px' color='#57606a'&gt;(kernel)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff4ce;strokeColor=#bf8700;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="500" y="85" width="190" height="48" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;tuplefs&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="447" y="195" width="160" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;database&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#57606a'&gt;inodes · dirents&lt;br&gt;xattrs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dafbe1;strokeColor=#1a7f37;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="447" y="305" width="160" height="112" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;backing files&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#57606a'&gt;one per inode,&lt;br&gt;on ext4, xfs, …&lt;/font&gt;" style="shape=folder;tabWidth=70;tabHeight=14;tabPosition=left;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbefff;strokeColor=#8250df;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="690" y="305" width="140" height="112" as="geometry"/></mxCell><mxCell id="c13" value="metadata;&lt;br&gt;data if no passthrough" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;exitX=0.142;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="metadata:&lt;br&gt;one transaction each" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="read / write,&lt;br&gt;no SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;entryX=0.2;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="718" y="220"/></Array></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8250df;strokeWidth=2.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;entryX=0.82;entryY=0.125;entryPerimeter=0;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="109"/></Array></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;passthrough&lt;/b&gt;&lt;br&gt;data skips tuplefs" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#1f2328;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="672" y="140" width="126" height="34" as="geometry"/></mxCell><mxCell id="c18" value="sizes&lt;br&gt;≈ 1/s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="A write and its metadata commit together.&lt;br&gt;Backup and replication of the database cover everything." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#57606a;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="446" width="405" height="34" as="geometry"/></mxCell><mxCell id="c20" value="Data is as crash-safe as the disk's file system makes it. File sizes are&lt;br&gt;copied into the database about once a second, on fsync and at unmount.&lt;br&gt;Passthrough needs a mount by root and a kernel that has it." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#57606a;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="435" y="446" width="405" height="48" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=20;fillColor=#fff4ce;strokeColor=#bf8700;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="509" width="14" height="14" as="geometry"/></mxCell><mxCell id="c22" value="Linux kernel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#57606a;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="506" width="90" height="20" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;arcSize=20;fillColor=#ddf4ff;strokeColor=#0969da;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="134" y="509" width="14" height="14" as="geometry"/></mxCell><mxCell id="c24" value="tuplefs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#57606a;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="154" y="506" width="55" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;arcSize=20;fillColor=#dafbe1;strokeColor=#1a7f37;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="509" width="14" height="14" as="geometry"/></mxCell><mxCell id="c26" value="database" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#57606a;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="253" y="506" width="62" height="20" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;arcSize=20;fillColor=#fbefff;strokeColor=#8250df;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="339" y="509" width="14" height="14" as="geometry"/></mxCell><mxCell id="c28" value="files on disk" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#57606a;fontFamily=Helvetic
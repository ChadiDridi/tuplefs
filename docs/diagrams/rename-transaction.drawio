<mxfile host="app.diagrams.net">
  <diagram name="rename transaction" id="rename-transaction">
    <mxGraphModel dx="900" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='rename("config.tmp", "config") over an existing file is one transaction' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1f2328;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="840" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;before&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;config&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; → inode 7&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;config.tmp → inode 9&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;inode 7: 1 name, old data&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;inode 9: 1 name, new data&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="0" y="95" width="205" height="118" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;after&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;config&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; → inode 9&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;inode 7: deleted&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:12px'&gt;inode 9: 1 name, new data&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="635" y="95" width="205" height="118" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;one database transaction&lt;/b&gt;" style="swimlane;startSize=28;html=1;rounded=1;arcSize=6;fillColor=#dafbe1;strokeColor=#1a7f37;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="250" y="50" width="340" height="216" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font color='#1a7f37'&gt;&lt;b&gt;BEGIN&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="32" width="340" height="22" as="geometry"/></mxCell><mxCell id="c6" value="1&amp;nbsp; lock the directory, then inodes 7 and 9" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="54" width="340" height="22" as="geometry"/></mxCell><mxCell id="c7" value="2&amp;nbsp; inode 7: one name fewer, now 0" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="76" width="340" height="22" as="geometry"/></mxCell><mxCell id="c8" value="3&amp;nbsp; delete inode 7 and its data*" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="98" width="340" height="22" as="geometry"/></mxCell><mxCell id="c9" value='4&amp;nbsp; point the name "config" at inode 9' style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="120" width="340" height="22" as="geometry"/></mxCell><mxCell id="c10" value='5&amp;nbsp; remove the name "config.tmp"' style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="142" width="340" height="22" as="geometry"/></mxCell><mxCell id="c11" value="6&amp;nbsp; update the directory's timestamps" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="164" width="340" height="22" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font color='#1a7f37'&gt;&lt;b&gt;COMMIT&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontFamily=Helvetica;fontColor=#1f2328;strokeColor=none;fillColor=none;" vertex="1" parent="c4"><mxGeometry x="0" y="186" width="340" height="22" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.48;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#424a53;strokeWidth=1.5;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.48;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;crash before COMMIT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#57606a'&gt;the database rolls back:&lt;br&gt;the file system is exactly &quot;before&quot;&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="400" height="62" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;after COMMIT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#57606a'&gt;the file system is exactly &quot;after&quot;&lt;br&gt;no state in between is ever visible&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#1a7f37;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="400" height="62" as="geometry"/></mxCell><mxCell id="c17" value="* If a program still has the old file open, its data stays until the last close. In the hybrid layout the data is a backing file, removed right after the commit." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#57606a;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="372" width="840" height="34" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
